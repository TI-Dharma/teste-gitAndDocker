# Defina o ambiente ativo (quando rodar localmente): PROD, TEST ou DEV
AMBIENTE=PROD

# URL do seu repositório Git (os contêineres puxam a branch daqui automaticamente)
GIT_REPO_URL=https://github.com/TI-Dharma/teste-gitAndDocker.git

# Branches correspondentes a cada ambiente
PROD_BRANCH=main
TEST_BRANCH=test
DEV_BRANCH=dev

# Portas do ambiente PROD (puxa a branch main)
PROD_BACK_PORT=4000
PROD_FRONT_PORT=3000

# Portas do ambiente TEST (puxa a branch test)
TEST_BACK_PORT=4001
TEST_FRONT_PORT=3001

# Portas do ambiente DEV (puxa a branch dev)
DEV_BACK_PORT=4002
DEV_FRONT_PORT=3002
